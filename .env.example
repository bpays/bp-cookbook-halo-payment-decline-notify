# Copy to .env and fill in the blanks. Never commit .env.
# The sample loads .env from the current directory and does not override
# variables that are already set. A shell `#` comment after a value is ignored.

# Benji Pays organization API key. Sent as the x-api-key header.
BENJI_PAYS_API_KEY=
BENJI_PAYS_API_URL=https://api.benjipays.com  # pragma: allowlist secret
BENJI_PAYS_APP_URL=https://app.benjipays.com  # pragma: allowlist secret

# Halo API application (client credentials).
HALO_RESOURCE_URL=https://YOUR_TENANT.halopsa.com/api
HALO_AUTH_URL=https://YOUR_TENANT.halopsa.com/auth
HALO_CLIENT_ID=
HALO_CLIENT_SECRET=
# Optional. Set this if your Halo URLs require a tenant slug.
HALO_TENANT=
HALO_SCOPE=all

# Ticket type name in your Halo tenant. The sample looks up the id at runtime.
HALO_PAYMENT_DECLINE_TICKET_TYPE=Payment Decline
# Or set the id yourself if you already know it for this tenant:
# HALO_PAYMENT_DECLINE_TICKET_TYPE_ID=
HALO_CREDIT_HOLD_FIELD=CFCreditHold
HALO_CLIENT_MATCH_FIELD=accountsid
# Comma-separated custom fields tried after HALO_CLIENT_MATCH_FIELD.
# HALO_CLIENT_MATCH_FALLBACKS=BenjiCustomerId,AccountingId,accountsid

# Calendar used for the aged-invoice day count. IANA name, for example UTC or America/Chicago.
TIMEZONE=UTC
